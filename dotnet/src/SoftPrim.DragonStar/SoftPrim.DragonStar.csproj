<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>SoftPrim.DragonStar</RootNamespace>
    <AssemblyName>SoftPrim.DragonStar</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>SoftPrim.DragonStar</PackageId>
    <Version>1.0.0</Version>
    <Authors>SoftPrim Technology SRL</Authors>
    <Company>SoftPrim Technology SRL</Company>
    <Copyright>Copyright (c) SoftPrim Technology SRL</Copyright>
    <Description>Client .NET pentru API-ul Dragon Star Curier v1: AWB-uri, cotații, urmărire, etichete, ridicări, borderouri. / .NET client for the Dragon Star Curier API v1.</Description>
    <PackageTags>dragonstar;curier;courier;awb;shipping;romania;softprim</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/softprim/dragonstar-curier-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/softprim/dragonstar-curier-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
